+typedef struct {
+    uint8_t mac[6];
+    uint16_t sport;
+    uint16_t dport;
+    uint8_t ip_version;
+    uint8_t src_addr[16];
+    uint8_t dst_addr[16];
+    uint64_t ts_usec;
+    uint8_t routed;
+    uint8_t valid;
